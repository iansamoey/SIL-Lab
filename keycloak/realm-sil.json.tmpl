{
  "realm": "sil",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "clientScopes": [
    {
      "name": "claims:submit",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "claims:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "patients:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "ai:use",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "hospital-client",
      "name": "Lab hospital (provider PRV-001)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HOSPITAL_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "claims:submit",
        "claims:read",
        "patients:read"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-sil-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sil-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "PRV-001",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "insurer-client",
      "name": "Lab insurer (INS-001)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${INSURER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "claims:read"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-sil-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sil-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "insurer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "insurer_id",
            "claim.value": "INS-001",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "internal-tool",
      "name": "Internal AI-enabled tool",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${INTERNAL_TOOL_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "ai:use"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-sil-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sil-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "dast-scanner",
      "name": "OWASP ZAP scanner (staging only, read-only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DAST_SCANNER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "access.token.lifespan": "900"
      },
      "defaultClientScopes": [
        "claims:read",
        "patients:read"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-sil-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sil-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "PRV-DAST",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-hospital-client",
      "enabled": true,
      "serviceAccountClientId": "hospital-client"
    },
    {
      "username": "service-account-insurer-client",
      "enabled": true,
      "serviceAccountClientId": "insurer-client"
    },
    {
      "username": "service-account-internal-tool",
      "enabled": true,
      "serviceAccountClientId": "internal-tool"
    },
    {
      "username": "service-account-dast-scanner",
      "enabled": true,
      "serviceAccountClientId": "dast-scanner"
    }
  ]
}
